# 이 파일은 레거시 참고용입니다. 실제 값은 루트 .env에 넣고
# scripts/sync-functions-env.ps1로 functions/.env를 생성합니다. Git에 올리지 마세요.
DISCORD_COHORT_ID=cohort_34

# DISCORD_BOT_TOKEN 은 Secret Manager 사용:
# firebase functions:secrets:set DISCORD_BOT_TOKEN
# 공지 벡터(noticeVectors)가 읽는 파인콘 키도 Secret Manager 다:
# firebase functions:secrets:set PINECONE_API_KEY2

# 공공데이터포털 — 국가자격 시험일정 API (일반 인증키, Decoding 키 사용)
DATA_GO_KR_SERVICE_KEY=

# 성취도평가 커리큘럼 AI (각자 키 — Git에 올리지 마세요)
# 반영하려면: firebase deploy --only functions
OPENAI_API_KEY=
