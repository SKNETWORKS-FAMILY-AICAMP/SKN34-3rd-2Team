# Discord 동기화 (functions/.env 로 복사 후 사용, Git에 올리지 마세요)
DISCORD_COHORT_ID=cohort_34

# DISCORD_BOT_TOKEN 은 Secret Manager 사용:
# firebase functions:secrets:set DISCORD_BOT_TOKEN

# 공공데이터포털 — 국가자격 시험일정 API (일반 인증키, Decoding 키 사용)
DATA_GO_KR_SERVICE_KEY=

# 성취도평가 커리큘럼 AI (각자 키 — Git에 올리지 마세요)
# 반영하려면: firebase deploy --only functions
OPENAI_API_KEY=
