# Copy this file to .env and put real secrets only in .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=static_job_postings
RETRIEVAL_TOP_K=4
APP_ENV=local

# Firebase integration is intentionally deferred. Never send this value to Flutter.
FIREBASE_PROJECT_ID=

