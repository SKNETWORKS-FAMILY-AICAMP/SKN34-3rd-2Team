rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──

    /// 인증 여부
    function isAuthenticated() {
      return request.auth != null;
    }

    /// users/{uid} 문서 데이터 조회
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// 활성 사용자 여부
    function isActiveUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().isActive == true;
    }

    /// 관리자 여부
    function isAdmin() {
      return isActiveUser() && getUserData().role == 'admin';
    }

    /// 특정 기수 소속 여부
    function belongsToCohort(cohortId) {
      return isActiveUser() && getUserData().cohortId == cohortId;
    }

    /// 관리자이거나 해당 기수 소속
    function canAccessCohort(cohortId) {
      return isAdmin() || belongsToCohort(cohortId);
    }

    /// 본인 문서 여부
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── 학생 상담 정보 (관리자 전용, PW 포함) ──

    match /studentIntakes/{userId} {
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(userId)
          && isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['passwordChanged'])
          && request.resource.data.passwordChanged == true)
        || (isOwner(userId)
          && isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['personalEmail']));
    }

    // ── users 컬렉션 ──

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // 학생: 본인 프로필 일부 필드만 수정 (skills, motto, socialLinks, personalEmail 등)
      allow update: if isOwner(userId)
        && isActiveUser()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'cohortId', 'cohortName', 'isActive', 'mileageBalance', 'email']);

      // 관리자: 전체 수정
      allow update: if isAdmin();

      // 계정 생성은 Cloud Functions(Admin SDK)만 — 클라이언트 create 금지
      allow create: if false;
      allow delete: if isAdmin();

      // 개인 TODO subcollection
      match /todos/{todoId} {
        allow read, write: if isOwner(userId) && isActiveUser();
      }
    }

    // ── cohorts 컬렉션 ──

    match /cohorts/{cohortId} {
      // 기수 메타: 소속 학생/관리자 읽기, 관리자만 쓰기
      allow read: if belongsToCohort(cohortId) || isAdmin();
      allow write: if isAdmin();

      // ── 시간표 ──
      match /schedules/{scheduleId} {
        allow read: if canAccessCohort(cohortId);
        allow write: if isAdmin();
      }

      // ── 자리 배치 ──
      match /seating/{docId} {
        allow read: if canAccessCohort(cohortId);
        allow write: if isAdmin();
      }

      // ── 출결 ──
      match /attendances/{attendanceId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // ── 공지사항 ──
      match /notices/{noticeId} {
        allow read: if canAccessCohort(cohortId);
        allow write: if isAdmin();
      }

      // ── 소통 피드 ──
      match /posts/{postId} {
        allow read: if canAccessCohort(cohortId);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.authorId == request.auth.uid);

        match /comments/{commentId} {
          allow read: if canAccessCohort(cohortId);
          allow create: if belongsToCohort(cohortId)
            && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isAdmin()
            || (belongsToCohort(cohortId)
              && resource.data.authorId == request.auth.uid);
        }
      }

      // ── 1:1 Q&A ──
      match /qna/{threadId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.studentId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.studentId == request.auth.uid;
        allow update: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.studentId == request.auth.uid);

        match /messages/{messageId} {
          allow read: if isAdmin()
            || (belongsToCohort(cohortId)
              && get(/databases/$(database)/documents/cohorts/$(cohortId)/qna/$(threadId)).data.studentId
                == request.auth.uid);
          allow create: if canAccessCohort(cohortId)
            && request.resource.data.senderId == request.auth.uid;
        }
      }

      // ── 강의 자료 ──
      match /materials/{materialId} {
        allow read: if canAccessCohort(cohortId);
        allow write: if isAdmin();
      }

      // ── 과제 ──
      match /assignments/{assignmentId} {
        allow read: if canAccessCohort(cohortId);
        allow write: if isAdmin();

        match /submissions/{submissionUserId} {
          allow read: if isAdmin()
            || (belongsToCohort(cohortId)
              && submissionUserId == request.auth.uid);
          allow create, update: if belongsToCohort(cohortId)
            && submissionUserId == request.auth.uid;
          allow delete: if isAdmin();
        }
      }

      // ── 구글폼 설문 ──
      match /formTasks/{taskId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId) && resource.data.published == true);
        allow write: if isAdmin();

        match /responses/{responseUserId} {
          allow read: if isAdmin()
            || (belongsToCohort(cohortId) && responseUserId == request.auth.uid);
          allow write: if false;
        }
      }

      // ── 이력서 ──
      match /resumes/{resumeId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow delete: if belongsToCohort(cohortId)
          && resource.data.userId == request.auth.uid;

        match /feedback/{feedbackId} {
          allow read: if isAdmin()
            || (belongsToCohort(cohortId)
              && get(/databases/$(database)/documents/cohorts/$(cohortId)/resumes/$(resumeId)).data.userId
                == request.auth.uid);
          allow write: if isAdmin();
        }

        match /revisions/{revisionId} {
          allow read: if isAdmin()
            || (belongsToCohort(cohortId)
              && get(/databases/$(database)/documents/cohorts/$(cohortId)/resumes/$(resumeId)).data.userId
                == request.auth.uid);
          allow create: if belongsToCohort(cohortId)
            && get(/databases/$(database)/documents/cohorts/$(cohortId)/resumes/$(resumeId)).data.userId
              == request.auth.uid;
        }
      }

      // ── 마일리지 거래 ──
      match /mileageTransactions/{txId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow write: if isAdmin();
      }

      // ── 주간 필수 학습 ──
      match /weeklyTasks/{taskId} {
        allow read: if canAccessCohort(cohortId);
        allow write: if isAdmin();
      }

      match /userProgress/{progressUserId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && progressUserId == request.auth.uid);
        allow create, update: if belongsToCohort(cohortId)
          && progressUserId == request.auth.uid;
      }

      // ── 제출/승인 (블로그 등) ──
      match /submissions/{submissionId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid
            && request.resource.data.status == resource.data.status);
      }

      // ── 성취도 평가 ──
      match /assessments/{assessmentId} {
        allow read: if canAccessCohort(cohortId);
        allow write: if isAdmin();
      }

      match /assessmentSubmissions/{submissionId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow create, update: if belongsToCohort(cohortId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isAdmin();
      }

    }

    // ── 시스템 캐시 (국가자격 시험일정 등) ──
    match /systemCache/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}
